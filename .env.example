# Copy the relevant values into backend/.env for local development.
# Copy Docker-specific values into backend/.env.docker when running with Docker.
# Never commit real API keys or passwords.

# Local backend database
DATABASE_URL=mysql+pymysql://root:@localhost:3306/newdatabase

# Docker backend database
# DATABASE_URL=mysql+pymysql://root:password123@mysql:3306/newdatabase

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# For Docker backend talking to Ollama running on Windows:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Chroma vector store
CHROMA_PERSIST_DIRECTORY=./chroma_db

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rag-knowledge-engine

# Optional legacy LangChain tracing names for compatibility
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-knowledge-engine

# Groq evaluation only
GROQ_API_KEY=your_groq_api_key_here
GROQ_EVAL_MODEL=openai/gpt-oss-120b

# Frontend local development
VITE_API_BASE_URL=http://localhost:8000
